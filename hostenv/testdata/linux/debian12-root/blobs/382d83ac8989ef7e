[Unit]
Description=Shentu daily security report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/shentu patrol --daily
EnvironmentFile=-/etc/shentu/env
ProtectSystem=strict
ReadWritePaths=/var/lib/shentu
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
