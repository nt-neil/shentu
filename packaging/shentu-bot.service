[Unit]
Description=Shentu Telegram bot (answers the paired user only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/shentu bot
EnvironmentFile=-/etc/shentu/env
Restart=on-failure
RestartSec=30
ProtectSystem=strict
ReadWritePaths=/var/lib/shentu
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# No CAP_NET_ADMIN: the bot cannot change the firewall. `shentu setup` adds it with a
# drop-in (shentu-bot.service.d/actions.conf) only for [bot] interaction = 3 or 4.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
